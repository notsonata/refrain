{
  "name": "refrain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src vite.config.ts svelte.config.js",
    "format": "prettier --write \"src/**/*.{ts,svelte,css}\" \"*.{js,ts,json,html}\"",
    "format:check": "prettier --write \"src/**/*.{ts,svelte,css}\" \"*.{js,ts,json,html}\" && git diff --exit-code",
    "test": "vitest run",
    "test:watch": "vitest",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "svelte": "5.56.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.11.0",
    "eslint": "10.11.0",
    "eslint-plugin-svelte": "3.23.0",
    "prettier": "3.9.8",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.0.16",
    "vitest": "5.0.1"
  }
}
