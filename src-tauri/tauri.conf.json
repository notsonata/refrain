{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Refrain",
  "version": "0.1.0",
  "identifier": "io.github.notsonata.refrain",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Refrain",
      "width": 1100,
      "height": 720,
      "minWidth": 840,
      "minHeight": 560
    }],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; img-src 'self' data: https://i.scdn.co; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": { "active": false }
}
